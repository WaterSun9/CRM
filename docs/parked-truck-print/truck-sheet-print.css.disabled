                        margin: 0 !important;
                        overflow: hidden !important;
                        box-shadow: none !important;
                        break-after: page;
                        page-break-after: always;
                    }
                    .truck-sheet-print .truck-sheet-page > header {
                        display: flex !important;
                        flex-direction: row !important;
                        align-items: flex-start !important;
